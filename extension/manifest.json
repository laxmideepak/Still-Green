{
  "manifest_version": 3,
  "name": "Stillgreen — Slack token capture",
  "version": "1.0.0",
  "description": "Reads your own signed-in Slack session and sends it only to the Stillgreen daemon URL you set, normally http://127.0.0.1:8765 on this machine.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "scripting"],
  "host_permissions": [
    "https://*.slack.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stillgreen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
